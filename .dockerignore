# ============================================================================
# Docker 构建上下文排除（配合根目录 Dockerfile / Dockerfile.deploy 使用）
# 只保留构建所需源码，避免把本地产物/密钥/元数据打进上下文
# ============================================================================

# VCS 与 agent 配置
.git
.git-internal
.agents
.claude
.codegraph
.reasonix

# 配置目录整体排除：镜像不再内置配置（runtime 阶段已无 COPY configs；
# backend 的 COPY . . 也不需要 configs——彻底避免生产配置进入镜像/构建缓存）
configs
.env
.env.*

# 数据与本地构建产物
data
.data
bin
build
*.app
*.dmg
*.exe
*.test

# 官网站点（pnpm workspace 另一包）源码保留：pnpm install 需解析其 package.json；
# 其 node_modules 与 dist 由下方 **/node_modules、*/dist 排除

# 部署配置模板（运行时经 volume 挂载，含用户密钥，禁止进镜像）
deploy

# 所有 node_modules（pnpm workspace 每包一份；镜像内重新 pnpm install）
**/node_modules
*/dist

# 日志与系统文件
*.log
.DS_Store
