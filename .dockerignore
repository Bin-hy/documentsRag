# ============================================================================
# Docker 构建上下文排除（配合 Dockerfile.deploy 使用）
# 只保留构建所需源码，避免把本地产物/密钥/元数据打进上下文
# ============================================================================

# VCS 与 agent 配置
.git
.git-internal
.agents
.claude
.codegraph
.reasonix

# 本地私有配置（configs/*.local.* 会被 config 自动合并，严禁进镜像；
# 例外：deploy/configs/*.local.yaml.example 模板仍可留在构建上下文，无害）
configs/*.local.*
.env
.env.*

# 数据与本地构建产物
data
.data
bin
build
*.app
*.dmg
*.exe
*.test

# 前端依赖与本地产物（镜像内重新 npm ci + build）
frontend/node_modules
*/dist

# 日志与系统文件
*.log
.DS_Store
