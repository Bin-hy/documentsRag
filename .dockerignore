# ============================================================================
# Docker 构建上下文排除（配合 Dockerfile.deploy 使用）
# 只保留构建所需源码，避免把本地产物/密钥/元数据打进上下文
# ============================================================================

# VCS 与 agent 配置
.git
.git-internal
.agents
.claude
.codegraph
.reasonix

# 配置目录整体排除：镜像不再内置配置（runtime 阶段已无 COPY configs；
# backend 的 COPY . . 也不需要 configs——彻底避免生产配置进入镜像/构建缓存）
configs
.env
.env.*

# 数据与本地构建产物
data
.data
bin
build
*.app
*.dmg
*.exe
*.test

# 前端依赖与本地产物（镜像内重新 npm ci + build）
frontend/node_modules
*/dist

# 日志与系统文件
*.log
.DS_Store
